---
import ThemeToggle from "./ThemeToggle.astro";
import { NAVITEMS } from "./DATA";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full px-2 mx-auto mt-3"
>
  <nav
    class="flex items-center justify-center px-2 text-xs font-medium text-gray-600 border border-transparent rounded-full sm:px-3 sm:text-sm dark:text-gray-300"
  >
    {
      NAVITEMS.map((link) => (
        <a
          class="relative block px-1.5 py-2 transition sm:px-2.5 hover:text-pink-500 dark:hover:text-pink-400"
          data-nav={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section[id]");
    const navItems = document.querySelectorAll<HTMLElement>("header nav a");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navItems.forEach((item) => {
            item.classList.toggle(
              "!text-pink-500",
              item.dataset.nav === entry.target.id
            );
          });
        });
      },
      { root: null, rootMargin: "-40% 0px -55% 0px", threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  :global(.dark) nav {
    animation-name: nav-shadow-dark;
  }

  @keyframes nav-shadow {
    to {
      background-color: rgb(255 255 255 / 0.75);
      backdrop-filter: blur(12px);
      border-color: rgb(236 72 153 / 0.2);
      box-shadow: 0 10px 30px -10px rgb(236 72 153 / 0.25);
    }
  }

  @keyframes nav-shadow-dark {
    to {
      background-color: rgb(0 0 0 / 0.7);
      backdrop-filter: blur(12px);
      border-color: rgb(236 72 153 / 0.25);
      box-shadow: 0 10px 40px -10px rgb(236 72 153 / 0.35);
    }
  }
</style>
