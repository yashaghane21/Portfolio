---
interface Props {
  index: number;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="flex items-end gap-4 mb-10">
  <div>
    <p class="font-mono text-sm tracking-widest text-pink-600 dark:text-pink-400">
      {String(index).padStart(2, "0")} /
    </p>
    <h2
      class="mt-1 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
    >
      {title}
    </h2>
  </div>
  <div
    class="flex-1 h-px mb-3 bg-gradient-to-r from-pink-500/50 to-transparent"
  >
  </div>
</div>
