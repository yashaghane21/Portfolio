---
import GitHub from "./icons/tools/GitHub.astro";
import Link from "./icons/Link.astro";
import { PROJECTS, OTHER_PROJECTS } from "./DATA";
---

<div class="flex flex-col gap-8">
  {
    PROJECTS.map(({ image, title, subtitle, description, link, github, tags }, i) => (
      <article class="flex flex-col overflow-hidden card card-hover group md:flex-row">
        <div class="relative w-full overflow-hidden h-52 sm:h-60 md:h-auto md:w-2/5 shrink-0">
          {image ? (
            <>
              <img
                alt={title}
                class="object-cover object-top w-full h-full transition duration-700 group-hover:scale-105"
                loading="lazy"
                src={image}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent mix-blend-multiply" />
            </>
          ) : (
            <div class="relative flex flex-col justify-end w-full h-full p-6 bg-black">
              <div class="absolute inset-0 opacity-60 bg-grid [mask-image:linear-gradient(to_top,transparent,#000)]" />
              <div class="absolute rounded-full -top-16 -left-16 size-64 bg-pink-600/40 blur-3xl transition duration-700 group-hover:bg-pink-500/50" />
              <div class="absolute rounded-full -bottom-20 -right-10 size-48 bg-fuchsia-600/30 blur-3xl" />
              <span class="relative font-mono text-xs text-pink-300/80">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="relative mt-1 text-3xl font-bold text-white">{title}</span>
              <span class="relative mt-1 text-sm text-white/60">{subtitle}</span>
            </div>
          )}
        </div>

        <div class="flex flex-col w-full p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                {title}
              </h3>
              <p class="text-sm text-pink-600 dark:text-pink-400">{subtitle}</p>
            </div>
            <div class="flex items-center gap-2 text-gray-600 dark:text-gray-300 [&_svg]:size-5">
              {github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${title} on GitHub`}
                  class="p-2 transition border rounded-full border-black/10 dark:border-white/10 hover:text-pink-500 hover:border-pink-500/60"
                >
                  <GitHub />
                </a>
              )}
              {link && (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${title} live site`}
                  class="p-2 transition border rounded-full border-black/10 dark:border-white/10 hover:text-pink-500 hover:border-pink-500/60"
                >
                  <Link />
                </a>
              )}
            </div>
          </div>
          <ul class="mt-4 text-gray-700 dark:text-gray-300 [&_strong]:font-semibold [&_strong]:text-gray-900 dark:[&_strong]:text-pink-100">
            {description.map((item) => (
              <li
                class="relative pb-2 pl-5 before:content-['▹'] before:absolute before:left-0 before:text-pink-500"
                set:html={item}
              />
            ))}
          </ul>
          <ul class="flex flex-wrap gap-2 pt-3 mt-auto">
            {tags.map((tag) => <li class="chip">{tag}</li>)}
          </ul>
        </div>
      </article>
    ))
  }

  <div class="mt-4">
    <h3 class="mb-4 font-mono text-sm tracking-widest text-gray-500 uppercase dark:text-gray-400">
      Earlier projects
    </h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        OTHER_PROJECTS.map(({ title, subtitle, github, link, tags }) => (
          <div class="p-5 card card-hover">
            <div class="flex items-center justify-between gap-2">
              <h4 class="font-semibold text-gray-900 dark:text-white">{title}</h4>
              <div class="flex gap-3 text-gray-500 dark:text-gray-400 [&_svg]:size-4">
                {github && (
                  <a href={github} target="_blank" rel="noopener" aria-label={`${title} on GitHub`} class="hover:text-pink-500">
                    <GitHub />
                  </a>
                )}
                {link && (
                  <a href={link} target="_blank" rel="noopener" aria-label={`${title} live site`} class="hover:text-pink-500">
                    <Link />
                  </a>
                )}
              </div>
            </div>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{subtitle}</p>
            <p class="mt-3 font-mono text-xs text-pink-600/80 dark:text-pink-300/70">
              {tags.join(" · ")}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</div>
