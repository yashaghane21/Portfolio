---
import { PROFILE, SOCIALS } from "./DATA";

const currentYear = new Date().getFullYear();
const links = [
  { label: "Resume", href: PROFILE.resume },
  { label: "GitHub", href: SOCIALS.github },
  { label: "LinkedIn", href: SOCIALS.linkedin },
  { label: "LeetCode", href: SOCIALS.leetcode },
  { label: "Contact", href: `mailto:${PROFILE.email}` },
];
---

<footer
  class="container w-full px-4 mx-auto mt-24 mb-10 opacity-90 lg:max-w-4xl md:max-w-2xl"
>
  <div
    class="flex flex-col items-center justify-between gap-4 pt-6 border-t sm:flex-row border-pink-500/20"
  >
    <span class="text-sm text-zinc-700 dark:text-zinc-300">
      © {currentYear} {PROFILE.name}
    </span>
    <ul
      class="flex flex-wrap items-center justify-center text-sm font-medium gap-x-5 gap-y-2 text-zinc-700 dark:text-white/90"
    >
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              target={l.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener"
              class="hover:underline hover:text-pink-600 dark:hover:text-pink-300"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
