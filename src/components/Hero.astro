---
import Badge from "@/components/util/Badge.astro";
import ResumeIcon from "@/components/icons/Resume.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHubIcon from "@/components/icons/tools/GitHub.astro";
import LinkedInIcon from "@/components/icons/socials/LinkedIn.astro";
import SocialPill from "@/components/util/SocialPill.astro";
import { PROFILE, SOCIALS, STATS } from "./DATA";
---

<div class="max-w-3xl">
  <div class="flex items-center gap-4 mb-8">
    <div class="relative">
      <div
        class="absolute rounded-full -inset-1 bg-gradient-to-tr from-pink-500 via-fuchsia-500 to-rose-400 blur-md opacity-60"
      >
      </div>
      <img
        class="relative rounded-full size-16 ring-2 ring-pink-500"
        src="/yash.jpg"
        alt={PROFILE.name}
        width="64"
        height="64"
      />
    </div>
    <a
      href={SOCIALS.linkedin}
      target="_blank"
      rel="noopener"
      class="transition md:hover:scale-105"
    >
      <Badge>Open to SDE roles</Badge>
    </a>
  </div>

  <p class="font-mono text-sm tracking-widest text-pink-600 dark:text-pink-400">
    HEY, I’M
  </p>
  <h1
    class="mt-2 text-5xl font-extrabold tracking-tight sm:text-7xl text-gradient pb-1"
  >
    {PROFILE.name}
  </h1>
  <p class="mt-4 text-lg font-medium text-gray-800 sm:text-xl dark:text-white">
    {PROFILE.role}
  </p>
  <p
    class="max-w-2xl mt-5 text-lg text-pretty text-gray-600 dark:text-gray-400 [&>strong]:font-semibold [&>strong]:text-gray-900 dark:[&>strong]:text-pink-100"
  >
    Currently a <strong>Software Developer Intern at Infinite Analytics</strong>,
    building data pipelines on PySpark and FastAPI. I build full-stack web and
    mobile apps, scalable REST APIs, and <strong>GenAI systems</strong> with RAG,
    LLM APIs, and vector databases. Based in {PROFILE.location}.
  </p>

  <nav class="flex flex-wrap gap-3 mt-8">
    <SocialPill href={PROFILE.resume} variant="primary">
      <ResumeIcon />
      Resume
    </SocialPill>
    <SocialPill href={SOCIALS.linkedin}>
      <LinkedInIcon />
      LinkedIn
    </SocialPill>
    <SocialPill href={SOCIALS.github}>
      <GitHubIcon />
      GitHub
    </SocialPill>
    <SocialPill href={SOCIALS.leetcode}>LeetCode</SocialPill>
    <SocialPill href={`mailto:${PROFILE.email}`}>
      <MailIcon />
      Email
    </SocialPill>
  </nav>

  <dl class="grid grid-cols-2 gap-3 mt-12 sm:grid-cols-4">
    {
      STATS.map((stat) => (
        <div class="px-4 py-4 card card-hover">
          <dt class="sr-only">{stat.label}</dt>
          <dd class="text-3xl font-bold text-gradient">{stat.value}</dd>
          <dd class="mt-1 text-xs text-gray-600 dark:text-gray-400">
            {stat.label}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
