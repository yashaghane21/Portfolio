---
const personalImageAlt = "Yashodhar Patel";
import Badge from "@/components/util/Badge.astro";
import ConnectIcon from "@/components/icons/Connect.astro";
import ResumeIcon from "@/components/icons/Resume.astro";
import SocialPill from "@/components/util/SocialPill.astro";

const resume = "/Yashodhar_Patel_Resume.pdf";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/yash.jpg"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/yash-aghane-052382215/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Available for work</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hey, I’m Yash
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
     Building <strong> Gigzi</strong> and <strong
      >Third Year Computer Engineering Student</strong
    > from Mumbai, India 🇮🇳. Passionate about crafting efficient, innovative web
    solutions.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="https://www.linkedin.com/in/yash-aghane-052382215/">
      <ConnectIcon class="size-4" />
      Get In Touch
    </SocialPill>
    <SocialPill href={"https://drive.google.com/file/d/1hgO1bX7ldccT8w8WhVY1cVhQwT4dAWp-/view?usp=drive_link"}>
      <ResumeIcon class="size-4" />
      Resume
    </SocialPill>
  </nav>
</div>
