---
interface Props {
  title: string;
  company: string;
  location: string;
  type: string;
  date: string;
  stack: string[];
  links: { label: string; url: string }[];
  description: string[];
}

const { title, company, location, date, type, stack, links, description } =
  Astro.props;
---

<div class="relative pb-12 pl-8 sm:pl-10 group">
  <!-- timeline line + dot -->
  <span
    class="absolute left-[5px] top-2 bottom-0 w-px bg-gradient-to-b from-pink-500/60 via-pink-500/20 to-transparent"
  ></span>
  <span
    class="absolute left-0 top-1.5 size-[11px] rounded-full bg-pink-500 ring-4 ring-pink-500/20 shadow-[0_0_14px_rgba(236,72,153,0.9)]"
  ></span>

  <div class="p-5 card card-hover sm:p-6">
    <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-start">
      <div>
        <h3 class="text-lg font-bold text-gray-900 sm:text-xl dark:text-white">
          {title}
          <span class="text-pink-600 dark:text-pink-400">@ {company}</span>
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          {location}{type && ` · ${type}`}
        </p>
      </div>
      <time
        class="font-mono text-xs text-gray-500 sm:text-sm sm:pt-1 shrink-0 dark:text-gray-400"
        >{date}</time
      >
    </div>

    {
      links.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-2 text-sm">
          {links.map((l) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener"
              class="text-pink-600 underline decoration-pink-500/40 underline-offset-4 hover:decoration-pink-500 dark:text-pink-300"
            >
              {l.label} ↗
            </a>
          ))}
        </div>
      )
    }

    <ul
      class="mt-4 text-gray-700 dark:text-gray-300 [&_strong]:font-semibold [&_strong]:text-gray-900 dark:[&_strong]:text-pink-100"
    >
      {
        description.map((item) => (
          <li
            class="relative pb-2 pl-5 before:content-['▹'] before:absolute before:left-0 before:text-pink-500"
            set:html={item}
          />
        ))
      }
    </ul>
    <ul class="flex flex-wrap gap-2 mt-3">
      {stack.map((s) => <li class="chip">{s}</li>)}
    </ul>
  </div>
</div>
